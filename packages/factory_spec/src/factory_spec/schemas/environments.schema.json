{
  "$defs": {
    "ApiBinding": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "description": "https:// base URL in this environment",
          "type": "string",
          "x-ba-label": "Base URL"
        }
      },
      "required": [
        "base_url"
      ],
      "type": "object"
    },
    "EmailChannel": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "description": "Distribution list",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$",
          "type": "string",
          "x-ba-label": "Email"
        },
        "type": {
          "const": "email",
          "type": "string",
          "x-ba-label": "Type"
        }
      },
      "required": [
        "type",
        "address"
      ],
      "type": "object"
    },
    "EnvBinding": {
      "additionalProperties": false,
      "properties": {
        "alert_channels": {
          "description": "Channels by name",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "discriminator": {
                "mapping": {
                  "email": "#/$defs/EmailChannel",
                  "slack": "#/$defs/SlackChannel",
                  "sns": "#/$defs/SnsChannel"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SnsChannel"
                },
                {
                  "$ref": "#/$defs/EmailChannel"
                },
                {
                  "$ref": "#/$defs/SlackChannel"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 63
          },
          "type": "object",
          "x-ba-label": "Alert channels"
        },
        "apis": {
          "description": "API base URLs by API id",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/ApiBinding"
            }
          },
          "propertyNames": {
            "maxLength": 63
          },
          "type": "object",
          "x-ba-label": "APIs"
        },
        "enabled": {
          "default": true,
          "description": "Deploy to this environment",
          "type": "boolean",
          "x-ba-label": "Enabled"
        },
        "infrastructure": {
          "$ref": "#/$defs/Infrastructure",
          "description": "Create the pipeline's AWS resources, or use ones the infra team made",
          "x-ba-label": "Infrastructure owner"
        },
        "placement": {
          "$ref": "#/$defs/Placement",
          "description": "Account aliases",
          "x-ba-label": "Placement"
        },
        "portal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Portal base URL",
          "x-ba-label": "Portal"
        },
        "queues": {
          "description": "Queue names by queue id",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/QueueBinding"
            }
          },
          "propertyNames": {
            "maxLength": 63
          },
          "type": "object",
          "x-ba-label": "Queues"
        },
        "schedule_cron": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cron override for this environment",
          "x-ba-label": "Schedule override"
        },
        "secrets": {
          "$ref": "#/$defs/SecretStores",
          "description": "Secret store bindings",
          "x-ba-label": "Secret stores"
        },
        "sources": {
          "description": "Source bindings by source id",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/SourceBinding"
            }
          },
          "propertyNames": {
            "maxLength": 63
          },
          "type": "object",
          "x-ba-label": "Sources"
        }
      },
      "type": "object"
    },
    "InfraGroup": {
      "additionalProperties": false,
      "properties": {
        "adopt": {
          "default": false,
          "description": "create only: take over resources that already exist (Terraform import)",
          "type": "boolean",
          "x-ba-label": "Adopt"
        },
        "import_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Terraform import id per resource address, where it cannot be derived",
          "type": "object",
          "x-ba-label": "Import ids"
        },
        "mode": {
          "default": "create",
          "description": "create: the framework creates it; existing: the infra team provides it",
          "enum": [
            "create",
            "existing"
          ],
          "type": "string",
          "x-ba-label": "Owner"
        },
        "names": {
          "description": "Per resource key (task id, dispatcher, trigger, dlq): the name the infra team used",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 63
          },
          "type": "object",
          "x-ba-label": "Existing names"
        }
      },
      "type": "object"
    },
    "Infrastructure": {
      "additionalProperties": false,
      "description": "Who owns the pipeline's AWS resources in this environment (team stores, KMS, MWAA and EKS are platform's).",
      "properties": {
        "alerts": {
          "$ref": "#/$defs/InfraGroup",
          "description": "Topics, subscriptions and alarms for alert routing",
          "x-ba-label": "Alerts"
        },
        "compute": {
          "$ref": "#/$defs/InfraGroup",
          "description": "Lambda functions, event-source mapping, Pod Identity associations",
          "x-ba-label": "Compute"
        },
        "logs": {
          "$ref": "#/$defs/InfraGroup",
          "description": "Lambda log groups",
          "x-ba-label": "Log groups"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "create",
                "existing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Applies to every group not set below",
          "x-ba-label": "Default owner"
        },
        "queues": {
          "$ref": "#/$defs/InfraGroup",
          "description": "Trigger queue, dead-letter queue, queue policy",
          "x-ba-label": "Queues"
        },
        "resources": {
          "$ref": "#/$defs/InfraGroup",
          "description": "The resources declared in environments.yaml → resources",
          "x-ba-label": "Catalog resources"
        },
        "roles": {
          "$ref": "#/$defs/InfraGroup",
          "description": "Task and dispatcher roles and their policies",
          "x-ba-label": "IAM roles"
        }
      },
      "type": "object"
    },
    "JsonValue": {},
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "orchestration": {
          "default": "mwaa",
          "description": "Placement alias of the MWAA environment",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
          "x-ba-label": "Orchestration placement"
        },
        "workload": {
          "default": "team",
          "description": "Placement alias of the team account",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
          "x-ba-label": "Workload placement"
        }
      },
      "type": "object"
    },
    "QueueBinding": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "SQS queue name in the team account",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$",
          "type": "string",
          "x-ba-label": "Queue name"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ResourceInstance": {
      "additionalProperties": false,
      "description": "An AWS resource from the resource catalog (catalog/resources.v1.yaml), asked for by configuration.",
      "properties": {
        "environments": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9]{1,9}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only in these environments (default: all)",
          "x-ba-label": "Environments"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9<>._/-]{1,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "AWS name; <env> becomes the environment. Default: factory-<team>-<pipeline>-<id>",
          "x-ba-label": "Name"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "As the catalog type defines them",
          "type": "object",
          "x-ba-label": "Parameters"
        },
        "type": {
          "description": "A resource type from the resource catalog, e.g. sns_topic, cloudwatch_metric_alarm",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
          "x-ba-label": "Type"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "SecretStores": {
      "additionalProperties": false,
      "properties": {
        "aws_secrets_manager": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretsManagerBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Secrets Manager binding",
          "x-ba-label": "Secrets Manager"
        },
        "default": {
          "anyOf": [
            {
              "enum": [
                "vault",
                "aws_secrets_manager"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where this environment reads secrets (local runs use the developer's file)",
          "x-ba-label": "Default store"
        },
        "overrides": {
          "description": "Secrets read from another store in this environment",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "enum": [
                "vault",
                "aws_secrets_manager"
              ],
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 63
          },
          "type": "object",
          "x-ba-label": "Per-secret store"
        },
        "vault": {
          "anyOf": [
            {
              "$ref": "#/$defs/VaultBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vault binding",
          "x-ba-label": "Vault"
        }
      },
      "type": "object"
    },
    "SecretsManagerBinding": {
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "default": "",
          "description": "Prefix of secret names in this account",
          "pattern": "^[A-Za-z0-9/_+=.@-]{0,128}$",
          "type": "string",
          "x-ba-label": "Name prefix"
        }
      },
      "type": "object"
    },
    "SlackChannel": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "description": "e.g. #clinops-alerts",
          "pattern": "^#[a-z0-9_-]{1,80}$",
          "type": "string",
          "x-ba-label": "Slack channel"
        },
        "type": {
          "const": "slack",
          "type": "string",
          "x-ba-label": "Type"
        }
      },
      "required": [
        "type",
        "channel"
      ],
      "type": "object"
    },
    "SnsChannel": {
      "additionalProperties": false,
      "properties": {
        "topic": {
          "description": "Topic name in the team account",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$",
          "type": "string",
          "x-ba-label": "SNS topic"
        },
        "type": {
          "const": "sns",
          "type": "string",
          "x-ba-label": "Type"
        }
      },
      "required": [
        "type",
        "topic"
      ],
      "type": "object"
    },
    "SourceBinding": {
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For static sources: the bucket",
          "x-ba-label": "Bucket"
        },
        "buckets": {
          "description": "Buckets this source may read in this environment",
          "items": {
            "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
            "type": "string"
          },
          "type": "array",
          "x-ba-label": "Allowed buckets"
        },
        "fivetran_group": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For database sources: the Fivetran destination group id",
          "x-ba-label": "Fivetran group"
        },
        "placement": {
          "default": "team",
          "description": "Account alias of the buckets",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
          "x-ba-label": "Placement"
        },
        "prefix_roots": {
          "description": "Folders a trigger-supplied prefix must start with",
          "items": {
            "maxLength": 512,
            "pattern": "^([A-Za-z0-9_][A-Za-z0-9._-]*/)+$",
            "type": "string"
          },
          "type": "array",
          "x-ba-label": "Allowed prefixes"
        }
      },
      "type": "object"
    },
    "VaultBinding": {
      "additionalProperties": false,
      "properties": {
        "mount": {
          "description": "Vault KV v2 mount",
          "pattern": "^[a-z0-9_-]{1,64}$",
          "type": "string",
          "x-ba-label": "KV mount"
        },
        "namespace": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_/-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vault Enterprise namespace",
          "x-ba-label": "Namespace"
        }
      },
      "required": [
        "mount"
      ],
      "type": "object"
    }
  },
  "$id": "urn:pipeline-factory:spec:v1:environments",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "environments.yaml: owned by the platform team.",
  "properties": {
    "environments": {
      "description": "Bindings per environment (dev, test, ppt, prod)",
      "patternProperties": {
        "^[a-z][a-z0-9]{1,9}$": {
          "$ref": "#/$defs/EnvBinding"
        }
      },
      "type": "object",
      "x-ba-label": "Environments"
    },
    "resources": {
      "description": "Extra AWS resources by configuration: topics, alarms, dashboards, rules, buckets, queues, tables",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/ResourceInstance"
        }
      },
      "propertyNames": {
        "maxLength": 63
      },
      "type": "object",
      "x-ba-label": "Resources"
    }
  },
  "required": [
    "environments"
  ],
  "type": "object",
  "x-ba-label": "Environments: per-environment bindings",
  "x-hash": "binding",
  "x-owner-role": "platform"
}
