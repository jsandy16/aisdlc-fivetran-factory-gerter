          },
          "inputs": [
            "objects"
          ],
          "on_failure": {
            "action": "fail",
            "error_class": "data"
          },
          "outputs": [
            "copied"
          ],
          "plain_english": "Copy the object to the archive bucket without changing it, and never overwrite an existing copy.",
