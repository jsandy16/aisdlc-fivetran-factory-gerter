          },
          "inputs": [
            "event"
          ],
          "on_failure": {
            "action": "fail",
            "error_class": "data"
          },
          "outputs": [
            "objects"
          ],
          "plain_english": "Find the new object named in the event and check that it exists.",
          "preconditions": [],
          "requirements": [],
          "rule_id": "r_list_object",
          "test_cases": []
