            "label": "Copy the new object",
            "retry": null,
            "rules": [
              "r_read_event",
              "r_list_object",
              "r_copy"
            ],
            "task_id": "t1_copy",
            "timeout": 600
          }
        ]
      },
      "reliability": {
        "replay_window": 2592000,
        "retry": {
          "backoff": "exponential_jitter",
          "base": 10,
          "max": 300,
          "max_attempts": 3
        },
        "run_key": "{bucket}-{key}-{version_id}"
      },
      "schema_version": "1.0.0",
