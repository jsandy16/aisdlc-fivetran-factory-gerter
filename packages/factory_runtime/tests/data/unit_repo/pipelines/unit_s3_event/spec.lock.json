        "owners": {
          "business_owner": "@alice-ba",
          "data_engineer": "@bob-de",
          "governance": "@carol-qa",
          "platform": "@dan-platform"
        },
        "pipeline_id": "unit_s3_event",
        "requirements": [],
        "spec_version": "0.1.0",
        "tags": {
          "cost_centre": "CC1234"
        },
        "team": "clinops_data"
      },
      "observability": {
        "alerts": {
          "config": "platform",
          "data": "data_owner",
          "security": "security",
          "transient": "none"
        },
        "sla": 10800
      },
      "open_questions": [],
