        "key_prefix": "incoming/",
        "key_suffix": null,
        "max_receive_count": 5,
        "queue": "object_created",
        "type": "s3_event"
      },
      "variables": {
        "bucket": "trigger.object.bucket",
        "key": "trigger.object.key",
        "version_id": "trigger.object.version_id"
      },
      "workload": {
        "bytes_per_run": {
          "max": 2000000000,
          "p50": 10000000,
          "p95": 500000000
        },
        "files_per_run": {
          "max": 1,
          "p50": 1,
          "p95": 1
        },
        "runs_per_day": 500
      }
    },
    "rules": {
      "rules": [
        {
          "category": "upload",
          "implementation": {
            "kind": "builtin",
            "op": "s3.copy",
