    "pipeline": {
      "api_version": "factory/v1",
      "artifacts": {},
      "cost": {
        "budget_per_month_usd": "5.00",
        "budget_per_run_usd": "0.01"
      },
      "kind": "Pipeline",
      "metadata": {
        "description": "Copy every new object from the source bucket to the archive bucket.",
