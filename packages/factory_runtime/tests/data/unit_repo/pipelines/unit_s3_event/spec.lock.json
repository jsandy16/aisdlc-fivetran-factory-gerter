          "inputs": [],
          "on_failure": {
            "action": "fail",
            "error_class": "data"
          },
          "outputs": [
            "event"
          ],
          "plain_english": "Take the S3 event that started this run, exactly as it was received.",
          "preconditions": [],
          "requirements": [],
          "rule_id": "r_read_event",
          "test_cases": []
        }
      ]
