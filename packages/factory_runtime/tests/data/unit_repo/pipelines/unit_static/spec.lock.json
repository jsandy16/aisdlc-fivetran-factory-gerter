          "preconditions": [],
          "requirements": [],
          "rule_id": "r_upload",
          "test_cases": []
        },
        {
          "category": "package",
          "implementation": {
            "kind": "builtin",
            "op": "package.zip",
            "params": {
              "compression": "deflate",
              "level": 6,
