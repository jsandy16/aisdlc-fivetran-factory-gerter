          "plain_english": "List every file in the zip with its size and SHA-256.",
          "preconditions": [],
          "requirements": [],
          "rule_id": "r_manifest",
          "test_cases": []
        },
        {
          "category": "naming",
          "implementation": {
            "kind": "builtin",
            "op": "naming.render",
            "params": {
              "template": "{batch_id}.zip"
