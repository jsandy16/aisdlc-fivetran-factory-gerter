            "request_id": {
              "fields": null,
              "items": null,
              "max_items": null,
              "max_length": null,
              "maximum": null,
              "minimum": null,
              "pattern": "^[A-Za-z0-9-]{8,64}$",
              "required": true,
              "type": "string",
              "values": null
            }
          },
          "unknown_fields": "reject"
        },
        "type": "manual"
      },
      "variables": {
        "batch_id": "trigger.conf.batch_id",
        "request_id": "trigger.conf.request_id"
      },
      "workload": {
        "bytes_per_run": {
          "max": 100000000,
          "p50": 1000000,
          "p95": 10000000
        },
        "files_per_run": {
          "max": 100,
          "p50": 5,
          "p95": 50
        },
        "runs_per_day": 1
      }
    },
    "rules": {
      "rules": [
