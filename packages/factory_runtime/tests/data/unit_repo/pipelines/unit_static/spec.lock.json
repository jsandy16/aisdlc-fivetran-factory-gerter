          },
          "inputs": [
            "files"
          ],
          "on_failure": {
            "action": "fail",
            "error_class": "data"
          },
          "outputs": [
            "package"
          ],
          "plain_english": "Zip the files in a fixed order.",
          "preconditions": [],
          "requirements": [],
          "rule_id": "r_zip",
          "test_cases": []
        }
      ]
    },
