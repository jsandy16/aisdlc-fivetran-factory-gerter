{
  "archive_originals": true,
  "entities": [
    {
      "attributes": [
        {
          "business_rule": "The vendor subject id is never stored in clear",
          "checks": [],
          "description": "Pseudonymised subject identifier",
          "input_format": null,
          "name": "subject_key",
          "nullable": false,
          "on_type_error": "quarantine_row",
          "precision": null,
          "scale": null,
          "source": "SUBJID",
          "transforms": [
            {
              "kind": "trim"
            },
            {
              "key": {
                "secret": "subject_key_salt"
              },
              "kind": "pseudonymise"
            }
          ],
          "type": "STRING"
        },
        {
          "business_rule": "",
          "checks": [
            {
              "description": "Site ids are 4 digits",
              "id": "site_id_format",
              "kind": "regex",
              "max_failed_pct": null,
              "mode": "enforce",
              "on_fail": "quarantine_row",
              "pattern": "^\\d{4}$",
              "tags": []
            }
          ],
          "description": "Investigator site",
          "input_format": null,
          "name": "site_id",
          "nullable": false,
          "on_type_error": "quarantine_row",
          "precision": null,
          "scale": null,
          "source": "SITEID",
          "transforms": [
            {
              "kind": "trim"
            },
            {
              "char": "0",
              "kind": "pad_left",
              "length": 4
            }
          ],
          "type": "STRING"
        },
        {
          "business_rule": "",
          "checks": [
            {
              "description": "Visits are numbered 1-99",
              "id": "visit_range",
              "kind": "range",
              "max": 99.0,
              "max_failed_pct": null,
              "min": 1.0,
              "mode": "enforce",
              "on_fail": "quarantine_row",
              "tags": []
            }
          ],
          "description": "Protocol visit number",
          "input_format": null,
          "name": "visit",
          "nullable": false,
          "on_type_error": "quarantine_row",
          "precision": null,
          "scale": null,
          "source": "VISIT",
          "transforms": [],
          "type": "INT"
        },
        {
          "business_rule": "",
          "checks": [],
          "description": "Date of the visit",
          "input_format": "%d%b%Y",
          "name": "visit_date",
          "nullable": false,
          "on_type_error": "quarantine_row",
          "precision": null,
          "scale": null,
          "source": "VISITDT",
          "transforms": [],
          "type": "NAIVE_DATE"
        },
        {
          "business_rule": "",
          "checks": [],
          "description": "Date the lab received the sample",
          "input_format": "%d%b%Y",
          "name": "received_date",
          "nullable": false,
          "on_type_error": "quarantine_row",
          "precision": null,
          "scale": null,
          "source": "RCVDT",
          "transforms": [],
          "type": "NAIVE_DATE"
        },
        {
          "business_rule": "",
          "checks": [
            {
              "description": "Only tests in the lab manual",
              "id": "test_code_known",
              "kind": "allowed_values",
              "max_failed_pct": null,
              "mode": "enforce",
              "on_fail": "quarantine_row",
              "tags": [],
              "values": [
                "ALT",
                "AST",
                "HGB",
                "WBC",
                "PLAT",
                "CREAT"
              ]
            }
          ],
          "description": "CDISC lab test code",
          "input_format": null,
          "name": "test_code",
          "nullable": false,
          "on_type_error": "quarantine_row",
          "precision": null,
          "scale": null,
          "source": "LBTESTCD",
          "transforms": [
            {
              "kind": "trim"
            },
            {
              "kind": "upper"
            }
          ],
          "type": "STRING"
        },
        {
          "business_rule": "",
          "checks": [],
          "description": "Result in original units",
          "input_format": null,
          "name": "result_value",
          "nullable": true,
          "on_type_error": "quarantine_row",
          "precision": 18,
          "scale": 6,
          "source": "LBORRES",
          "transforms": [],
          "type": "DECIMAL"
        },
        {
          "business_rule": "",
          "checks": [],
          "description": "Original unit",
          "input_format": null,
          "name": "result_unit",
          "nullable": true,
          "on_type_error": "quarantine_row",
          "precision": null,
          "scale": null,
          "source": "LBORRESU",
          "transforms": [],
          "type": "STRING"
        }
      ],
      "checks": [
        {
          "description": "Every delivery has lab results",
          "id": "lab_results_has_rows",
          "kind": "row_count",
          "max": null,
          "min": 1,
          "mode": "enforce",
          "on_fail": "reject_package",
          "tags": []
        },
        {
          "columns": [
            "subject_key",
            "visit",
            "test_code"
          ],
          "description": "One result per subject, visit and test in a delivery",
          "id": "lab_results_unique",
          "kind": "unique",
          "mode": "enforce",
          "on_fail": "reject_package",
          "tags": []
        },
        {
          "control_member": "^LB_CTRL\\.txt$",
          "count_pattern": "ROWS=(\\d+)",
          "description": "Row count matches the vendor control file",
          "id": "lab_results_control_count",
          "kind": "control_count",
          "mode": "enforce",
          "on_fail": "reject_package",
          "tags": []
        }
      ],
      "description": "One lab test result per subject, visit and test",
      "file": {
        "extra_columns": "reject",
        "format": {
          "delimiter": ",",
          "encoding": "utf-8",
          "header": true,
          "null_tokens": [
            "",
            "NA"
          ],
          "quotechar": "\"",
          "type": "csv"
        },
        "member": "^lab_results_\\d{3}\\.csv$"
      },
      "load": "upsert",
      "name": "lab_results",
      "primary_key": [
        "subject_key",
        "visit",
        "test_code"
      ],
      "row_checks": [
        {
          "description": "A result always has a unit",
          "expr": "row.result_value == null || row.result_unit != null",
          "id": "result_has_unit",
          "kind": "expression",
          "max_failed_pct": 5.0,
          "mode": "enforce",
          "on_fail": "quarantine_row",
          "tags": []
        },
        {
          "compiled_expr": "row.visit_date != null && row.received_date != null && row.visit_date <= row.received_date",
          "description": "Samples cannot be received before the visit",
          "examples": [
            {
              "expected": "pass",
              "input": {
                "received_date": "2024-03-02",
                "visit_date": "2024-03-01"
              }
            },
            {
              "expected": "pass",
              "input": {
                "received_date": "2024-03-02",
                "visit_date": "2024-03-02"
              }
            },
            {
              "expected": "fail",
              "input": {
                "received_date": "2024-03-02",
                "visit_date": "2024-03-03"
              }
            }
          ],
          "id": "visit_before_receipt",
          "kind": "english",
          "max_failed_pct": null,
          "mode": "enforce",
          "on_fail": "quarantine_row",
          "tags": [],
          "text": "The visit date must be on or before the date the lab received the sample. A row with either date missing fails."
        }
      ],
      "table": null
    }
  ],
  "environments": [
    "dev",
    "prod"
  ],
  "framework_version": "0.1.0",
  "gxp_tier": "gxp_indirect",
  "late_data_policy": "wait",
  "lock_version": 1,
  "originals": {
    "dev": {
      "access_key_id": {
