      "prefix": "originals",
      "region": "us-east-1",
      "secret_access_key": {
        "secret": "originals_secret_access_key_prod"
      }
    }
  },
  "pipeline": "oncology_labs",
  "rules_lock_sha256": "40f552b2f788cde055ab30cf7614ef30583e6bf94ecc4f8ada48d99f978dce99",
  "runtime": {
    "checkpoint_every_rows": 5000,
    "parallelism": 2,
    "python_version": "3.12",
    "retry": {
      "attempts": 5,
      "base_seconds": 2.0,
      "max_seconds": 60.0
    }
  },
  "runtime_version": "0.1.0",
  "secrets": {
    "dev": [
      "originals_access_key_id_dev",
      "originals_secret_access_key_dev",
      "sftp_private_key",
      "subject_key_salt"
    ],
    "prod": [
      "originals_access_key_id_prod",
      "originals_secret_access_key_prod",
      "sftp_private_key",
      "subject_key_salt"
    ]
  },
  "source": {
    "host": "sftp.centrallab.example",
    "host_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM+q46zWGkXM1yoev4CEou+F50Sc0fxiUJbCZpG6sHPp",
    "package": {
      "change_detection": "content",
      "checks": [
        {
          "description": "A delivery with no bytes is a broken source",
          "id": "package_not_empty",
          "kind": "not_empty",
          "mode": "enforce",
          "on_fail": "reject_package",
          "tags": []
        },
        {
          "description": "Delivery size within agreed bounds",
          "id": "package_size",
          "kind": "file_size",
          "max_bytes": 2147483648,
          "min_bytes": 100,
          "mode": "enforce",
          "on_fail": "reject_package",
          "tags": []
        },
        {
          "description": "The same file content is never loaded twice",
          "id": "package_not_duplicate",
          "kind": "duplicate_package",
          "lookback_packages": 500,
          "mode": "enforce",
          "on_fail": "reject_package",
          "tags": []
        },
        {
          "description": "File names follow LB_<study>_<seq>.zip",
          "id": "package_name",
          "kind": "file_name_pattern",
          "mode": "enforce",
          "on_fail": "reject_package",
          "pattern": "^LB_[A-Z0-9]+_\\d{3}\\.zip$",
          "tags": []
        },
        {
          "algorithm": "sha256",
          "description": "Content matches the vendor's SHA-256 sidecar",
          "id": "package_checksum",
          "kind": "checksum",
          "mode": "enforce",
          "on_fail": "reject_package",
          "sidecar": "{name}.sha256",
          "tags": []
        },
        {
          "allowed": [
            "zip"
          ],
          "description": "Deliveries are zip archives",
          "id": "package_is_zip",
          "kind": "package_type",
          "mode": "enforce",
          "on_fail": "reject_package",
          "tags": []
        },
        {
          "description": "Deliveries sit in a YYYYMMDD folder",
          "id": "package_folder",
          "kind": "folder_structure",
          "mode": "enforce",
          "on_fail": "reject_package",
          "path_pattern": "^\\d{8}$",
          "tags": []
        },
        {
          "description": "Each delivery has lab results and a control file",
          "id": "package_members",
          "kind": "required_members",
          "mode": "enforce",
          "on_fail": "reject_package",
          "patterns": [
            "^lab_results_\\d{3}\\.csv$",
            "^LB_CTRL\\.txt$"
          ],
          "tags": []
        },
        {
          "description": "No executable content",
          "id": "package_no_executables",
          "kind": "forbidden_members",
          "mode": "enforce",
          "on_fail": "reject_package",
          "patterns": [
            ".*\\.(exe|sh|bat|js)$"
          ],
          "tags": []
        },
        {
          "description": "Between 2 and 20 files per delivery",
          "id": "package_member_count",
          "kind": "member_count",
          "max": 20,
          "min": 2,
          "mode": "enforce",
          "on_fail": "reject_package",
          "tags": []
        }
      ],
      "match": "^(?P<date>[^/]+)/(?P<name>[^/]+)\\.zip$",
      "max_package_bytes": 2147483648,
      "on_redelivery": "reject",
      "on_unmatched": "warn",
      "order_by": [
        "date",
        "name"
      ],
      "readiness": {
        "marker": null,
        "min_age_seconds": 300
      },
      "transforms": [
        {
          "kind": "unzip",
          "max_members": 50,
          "max_ratio": 200,
          "max_total_bytes": 1073741824
        }
      ]
    },
    "password": null,
    "port": 22,
    "private_key": {
      "secret": "sftp_private_key"
    },
    "root": "/outbound/oncology",
    "timeout_seconds": 60,
    "type": "sftp",
    "username": "az_rd_ingest"
  },
  "spec_sha256": "b212601b60543ef79b27aed84f9ce469cbc4c77d609186fc0e1318be955e9127",
