# Generated by pipeline-factory from every pipeline in this repository (account-level objects).
# Do not edit: change the pipelines' policy/destination specs and run `pf build`.
# Lake Formation for prod: one definition per account, shared by every pipeline (oncology_labs, site_monitoring, trial_sites).
resource "aws_lakeformation_lf_tag" "classification" {
  key    = "pf_classification"
  values = ["public", "internal", "confidential", "restricted"]
}

resource "aws_lakeformation_lf_tag" "certified" {
  key    = "pf_certified"
  values = ["true", "false"]
}

resource "aws_lakeformation_lf_tag" "pipeline" {
  key    = "pf_pipeline"
  values = ["oncology_labs", "site_monitoring", "trial_sites"]
}

# Lake data written by Fivetran: governed by Lake Formation only (no hybrid IAM access).
resource "aws_lakeformation_resource" "az_rd_lake_prod_fivetran" {
  arn                     = "arn:aws:s3:::az-rd-lake-prod/fivetran"
  use_service_linked_role = true
  hybrid_access_enabled   = false
}

resource "aws_lakeformation_permissions" "az_rd_lake_prod_fivetran_fivetran_mdls" {
  principal   = "arn:aws:iam::222222222222:role/fivetran-mdls"
  permissions = ["DATA_LOCATION_ACCESS"]
  data_location {
    arn = aws_lakeformation_resource.az_rd_lake_prod_fivetran.arn
  }
}

resource "aws_lakeformation_permissions" "az_rd_lake_prod_fivetran_fivetran_mdls_prod" {
  principal   = "arn:aws:iam::222222222222:role/fivetran-mdls-prod"
  permissions = ["DATA_LOCATION_ACCESS"]
  data_location {
    arn = aws_lakeformation_resource.az_rd_lake_prod_fivetran.arn
  }
}
