# Generated by pipeline-factory from every pipeline in this repository (account-level objects).
# Do not edit: change the pipelines' policy/destination specs and run `pf build`.
data "aws_caller_identity" "current" {}
data "aws_partition" "current" {}
data "aws_region" "current" {}

resource "aws_cloudtrail" "audit_az_rd_pf_audit_prod" {
  name                          = "pf-audit-prod-az-rd-pf-audit-prod"
  s3_bucket_name                = aws_s3_bucket.audit_az_rd_pf_audit_prod.id
  s3_key_prefix                 = "cloudtrail"
  enable_log_file_validation    = true
  is_multi_region_trail         = true
  include_global_service_events = true
  advanced_event_selector {
    name = "Management events: Lake Formation grants and tags, Glue changes"
    field_selector {
      field  = "eventCategory"
      equals = ["Management"]
    }
  }
  advanced_event_selector {
    name = "Lake objects of the pipelines"
    field_selector {
      field  = "eventCategory"
      equals = ["Data"]
    }
    field_selector {
      field  = "resources.type"
      equals = ["AWS::S3::Object"]
    }
    field_selector {
      field       = "resources.ARN"
      starts_with = ["arn:${data.aws_partition.current.partition}:s3:::az-rd-lake-prod/fivetran/oncology_labs/", "arn:${data.aws_partition.current.partition}:s3:::az-rd-lake-prod/fivetran/site_monitoring/", "arn:${data.aws_partition.current.partition}:s3:::az-rd-lake-prod/fivetran/trial_sites/"]
    }
  }
  depends_on = [aws_s3_bucket_policy.audit_az_rd_pf_audit_prod]
}
