# Generated by pipeline-factory from every pipeline in this repository (account-level objects).
# Do not edit: change the pipelines' policy/destination specs and run `pf build`.
# Write-once evidence (dev): DQ results and certification records, CloudTrail logs.
resource "aws_s3_bucket" "audit_az_rd_pf_audit_dev" {
  bucket              = "az-rd-pf-audit-dev"
  object_lock_enabled = true
}

resource "aws_s3_bucket_versioning" "audit_az_rd_pf_audit_dev" {
  bucket = aws_s3_bucket.audit_az_rd_pf_audit_dev.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_object_lock_configuration" "audit_az_rd_pf_audit_dev" {
  bucket = aws_s3_bucket.audit_az_rd_pf_audit_dev.id
  rule {
    default_retention {
      mode = "GOVERNANCE"
      days = 9125
    }
  }
  depends_on = [aws_s3_bucket_versioning.audit_az_rd_pf_audit_dev]
}

resource "aws_s3_bucket_public_access_block" "audit_az_rd_pf_audit_dev" {
  bucket                  = aws_s3_bucket.audit_az_rd_pf_audit_dev.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "audit_az_rd_pf_audit_dev" {
  bucket = aws_s3_bucket.audit_az_rd_pf_audit_dev.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "aws:kms"
    }
    bucket_key_enabled = true
  }
}

resource "aws_s3_bucket_policy" "audit_az_rd_pf_audit_dev" {
  bucket = aws_s3_bucket.audit_az_rd_pf_audit_dev.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "CloudTrailAclCheck"
        Effect    = "Allow"
        Principal = { Service = "cloudtrail.amazonaws.com" }
        Action    = "s3:GetBucketAcl"
        Resource  = aws_s3_bucket.audit_az_rd_pf_audit_dev.arn
        Condition = { StringEquals = { "aws:SourceArn" = "arn:${data.aws_partition.current.partition}:cloudtrail:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:trail/pf-audit-dev-az-rd-pf-audit-dev" } }
      },
      {
        Sid       = "CloudTrailWrite"
        Effect    = "Allow"
        Principal = { Service = "cloudtrail.amazonaws.com" }
        Action    = "s3:PutObject"
        Resource  = "${aws_s3_bucket.audit_az_rd_pf_audit_dev.arn}/cloudtrail/AWSLogs/${data.aws_caller_identity.current.account_id}/*"
        Condition = { StringEquals = { "s3:x-amz-acl" = "bucket-owner-full-control", "aws:SourceArn" = "arn:${data.aws_partition.current.partition}:cloudtrail:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:trail/pf-audit-dev-az-rd-pf-audit-dev" } }
      },
      {
        Sid       = "DenyInsecureTransport"
        Effect    = "Deny"
        Principal = "*"
        Action    = "s3:*"
        Resource  = [aws_s3_bucket.audit_az_rd_pf_audit_dev.arn, "${aws_s3_bucket.audit_az_rd_pf_audit_dev.arn}/*"]
        Condition = { Bool = { "aws:SecureTransport" = "false" } }
      }
    ]
  })
}

