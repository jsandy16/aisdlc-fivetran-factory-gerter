          "preconditions": [],
          "requirements": [
            "REQ-004"
          ],
          "rule_id": "r_resolve_destinations",
          "test_cases": [
            {
              "expect": {
                "x": "test_delivery_s3",
                "y": "test_stub_sftp"
              },
              "given": {
                "env": "test",
                "portal": {
                  "x": "s3://acme-clinops-delivery-test/studies/ONC101/in/",
                  "y": "sftp://sftp-stub.test.acme.example/inbound/ONC101/"
