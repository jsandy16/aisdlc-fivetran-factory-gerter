          "REQ-001",
          "REQ-002",
          "REQ-003",
          "REQ-004",
          "REQ-005"
        ],
        "spec_version": "0.1.0",
        "tags": {
          "cost_centre": "CC1234"
        },
        "team": "clinops_data"
      },
      "observability": {
