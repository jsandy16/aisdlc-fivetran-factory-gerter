            {
              "expect": {
                "code": "destination_not_allowed",
                "error_class": "security"
              },
              "given": {
                "env": "test",
                "portal": {
                  "x": "s3://acme-clinops-delivery-test/studies/ONC999/in/",
                  "y": "sftp://sftp-stub.test.acme.example/inbound/ONC101/"
                },
                "vars": {
                  "study_id": "ONC101"
                }
              },
              "name": "other_study_rejected"
            }
          ]
        },
        {
          "category": "upload",
          "implementation": {
            "kind": "builtin",
            "op": "destination.deliver",
            "params": {
              "manifest": true,
              "object_name": "package_name",
              "sidecars": [
                "md5",
                "sha256"
              ],
              "slot": "x",
              "verify_after_write": true
            }
          },
          "inputs": [
            "package",
            "manifest",
            "package_checksum",
            "package_name",
            "destinations"
          ],
          "on_failure": {
            "action": "fail",
            "error_class": "data"
          },
          "outputs": [
            "delivered_x"
          ],
          "plain_english": "Deliver the zip, its manifest and its .md5 and .sha256 files to destination x; never overwrite a file that is already there, and re-check the delivered zip.",
          "preconditions": [],
          "requirements": [
            "REQ-005"
          ],
          "rule_id": "r_upload_x",
          "test_cases": []
        },
        {
          "category": "upload",
          "implementation": {
            "kind": "builtin",
            "op": "destination.deliver",
            "params": {
              "manifest": true,
              "object_name": "package_name",
              "sidecars": [
                "md5",
                "sha256"
              ],
              "slot": "y",
              "verify_after_write": true
