            "rules": [
              "r_package_name",
              "r_upload_x",
              "r_upload_y"
            ],
            "task_id": "t3_upload",
            "timeout": 7200
          }
        ]
      },
      "reliability": {
        "replay_window": 2592000,
        "retry": {
          "backoff": "exponential_jitter",
          "base": 10,
          "max": 300,
          "max_attempts": 3
        },
        "run_key": "{request_id}"
      },
      "schema_version": "1.0.0",
      "trigger": {
        "envelope": "raw",
        "max_receive_count": 5,
        "message": {
          "fields": {
            "bucket": {
              "fields": null,
              "items": null,
              "max_items": null,
              "max_length": null,
              "maximum": null,
              "minimum": null,
              "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
              "required": true,
              "type": "string",
              "values": null
            },
            "file_count": {
              "fields": null,
              "items": null,
              "max_items": null,
              "max_length": null,
              "maximum": 20000,
              "minimum": 1,
              "pattern": null,
              "required": true,
              "type": "integer",
              "values": null
            },
            "package_id": {
              "fields": null,
              "items": null,
              "max_items": null,
              "max_length": null,
              "maximum": null,
              "minimum": null,
