            "kind": "expression"
          },
          "inputs": [
            "listing"
          ],
          "on_failure": {
            "action": "fail",
            "error_class": "data"
          },
          "outputs": [],
          "plain_english": "The number of files and their total size must equal what the message announced.",
          "preconditions": [],
          "requirements": [
            "REQ-002"
          ],
          "rule_id": "r_check_listing",
          "test_cases": [
            {
              "expect": {
                "result": "pass"
              },
              "given": {
                "artifacts": {
                  "listing": {
                    "count": 3,
                    "total_bytes": 1200
                  }
                },
                "vars": {
                  "expected_bytes": 1200,
                  "expected_files": 3
                }
              },
              "name": "complete_upload"
            },
            {
              "expect": {
                "result": "fail"
              },
              "given": {
                "artifacts": {
                  "listing": {
                    "count": 2,
                    "total_bytes": 800
                  }
                },
                "vars": {
                  "expected_bytes": 1200,
                  "expected_files": 3
                }
              },
              "name": "missing_file"
            }
          ]
        },
        {
