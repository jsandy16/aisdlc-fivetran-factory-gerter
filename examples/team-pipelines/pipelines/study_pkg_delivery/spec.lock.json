            "action": "fail",
            "error_class": "data"
          },
          "outputs": [
            "package_checksum"
          ],
          "plain_english": "Re-read the stored zip and compute its MD5 and SHA-256; both must equal the values recorded while zipping.",
          "preconditions": [],
          "requirements": [
            "REQ-003"
          ],
          "rule_id": "r_checksum",
          "test_cases": []
        },
        {
          "category": "extract",
          "implementation": {
            "kind": "builtin",
            "op": "s3.download",
            "params": {
              "concurrency": 8,
              "verify": "size_and_etag"
