              "required": true,
              "type": "string",
              "values": null
            },
            "request_id": {
              "fields": null,
              "items": null,
              "max_items": null,
              "max_length": null,
              "maximum": null,
              "minimum": null,
              "pattern": "^[A-Za-z0-9-]{8,64}$",
              "required": true,
              "type": "string",
              "values": null
