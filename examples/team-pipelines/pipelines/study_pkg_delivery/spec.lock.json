              "t1_collect"
            ],
            "engine": "lambda",
            "label": "Checksum the stored zip",
            "retry": null,
            "rules": [
              "r_checksum"
            ],
            "task_id": "t2_checksum",
            "timeout": 900
          },
          {
            "depends_on": [
              "t2_checksum"
            ],
            "engine": "auto",
            "label": "Deliver to destinations x and y",
