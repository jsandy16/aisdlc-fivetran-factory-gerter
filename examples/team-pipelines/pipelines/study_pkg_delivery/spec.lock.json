          "inputs": [
            "listing"
          ],
          "on_failure": {
            "action": "fail",
            "error_class": "data"
          },
          "outputs": [
            "files"
          ],
          "plain_english": "Read each listed object as a stream, checking its size and ETag against the listing.",
          "preconditions": [],
          "requirements": [],
          "rule_id": "r_download",
          "test_cases": []
        },
        {
          "category": "extract",
          "implementation": {
            "kind": "builtin",
            "op": "s3.list",
            "params": {
              "exclude": [
                "**/.DS_Store",
                "**/Thumbs.db"
              ],
              "include": [
                "**/*"
              ],
              "max_objects": 20000,
              "max_total_bytes": 10000000000,
              "recursive": true,
              "source": "landing"
            }
          },
          "inputs": [
            "request"
          ],
          "on_failure": {
            "action": "fail",
            "error_class": "data"
          },
          "outputs": [
            "listing"
          ],
          "plain_english": "List every object under the bucket and folder named in the message, including sub-folders.",
