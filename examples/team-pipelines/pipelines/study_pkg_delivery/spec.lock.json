        {
          "category": "package",
          "implementation": {
            "kind": "builtin",
            "op": "package.zip",
            "params": {
              "compression": "deflate",
              "level": 6,
              "paths": "relative_to_prefix",
              "store_if_compressed": true,
              "zip64": "auto"
            }
          },
          "inputs": [
            "files"
          ],
          "on_failure": {
            "action": "fail",
            "error_class": "data"
          },
          "outputs": [
            "package"
